# Include in the existing PHP FastCGI snippet after loading the private origin-auth map.
# $lp_origin_ok must be generated by Nginx from an exact shared-secret match, default 0.
# Never derive either proof from client headers, X-Forwarded-Proto, or a localhost exemption.
fastcgi_param EPAY_ESA_ORIGIN_AUTH $lp_origin_ok;
fastcgi_param EPAY_ESA_ORIGIN_TLS $https;
# Keep the raw shared secret out of PHP request headers and application diagnostics.
fastcgi_param HTTP_X_LP_ORIGIN_AUTH "";
