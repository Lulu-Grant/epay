# Install as /etc/epay/ai-health.env with mode 0640 and owner root:www-data.
# Never place the real API key under the web root or commit it to Git.
HEALTH_AI_API_KEY=
HEALTH_AI_ALLOWED_HOSTS=
HEALTH_AI_ALLOWED_MODELS=
# Optional for hosts behind a local Fake-IP DNS proxy. Values must be globally routable IPv4 addresses.
# HEALTH_AI_PINNED_IPV4=api.example.com=93.184.216.34
